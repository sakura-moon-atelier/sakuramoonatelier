# ─────────────────────────────────────────────────────────────────
# SAKURA MOON ATELIER — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# All variables are optional — the app works without them (using
# sensible defaults or disabling the related feature).
# ─────────────────────────────────────────────────────────────────

# ── SITE ────────────────────────────────────────────────────────
# Your production domain (used for OG image URLs, sitemap, etc.)
VITE_SITE_URL=https://sakuramoonatelier.com

# ── CONTACT & PRESS ──────────────────────────────────────────────
VITE_CONTACT_EMAIL=hello@sakuramoonatelier.com
VITE_PRESS_EMAIL=press@sakuramoonatelier.com

# Press kit zip download URL (Google Drive, GitHub release, etc.)
VITE_PRESS_KIT_URL=

# Steam wishlist page URL
VITE_STEAM_WISHLIST=

# ── SOCIAL MEDIA ─────────────────────────────────────────────────
VITE_SOCIAL_INSTAGRAM=https://instagram.com/SakuraMoonGame
VITE_SOCIAL_TWITTER=https://twitter.com/SakuraMoonGame
VITE_SOCIAL_BLUESKY=https://bsky.app/profile/sakuramoon.bsky.social
VITE_SOCIAL_TIKTOK=https://tiktok.com/@SakuraMoonGame
VITE_SOCIAL_DISCORD=https://discord.gg/sakuramoon
VITE_SOCIAL_TWITCH=https://twitch.tv/SakuraMoonGame
VITE_SOCIAL_ITCHIO=https://sakuramoonatelier.itch.io
VITE_SOCIAL_STEAM=
VITE_SOCIAL_NINTENDO=
VITE_SOCIAL_PLAYSTATION=

# ── THIRD-PARTY SERVICES ─────────────────────────────────────────
# Formspree — contact form (https://formspree.io, free tier)
# Copy the 8-character ID from your form URL, e.g. 'xrgvkzwb'
VITE_FORMSPREE_ID=

# Mailchimp — newsletter (embed form action URL from Mailchimp dashboard)
VITE_MAILCHIMP_URL=

# Sentry — error monitoring (https://sentry.io, free tier)
VITE_SENTRY_DSN=

# Google Analytics — optional (format: G-XXXXXXXXXX)
VITE_GA_ID=

# ── DATA SOURCE ──────────────────────────────────────────────────
# Controls whether the app reads data from local files or your API.
# Values: 'static' (default) | 'remote'
VITE_DATA_SOURCE=static

# Your API base URL (only used when VITE_DATA_SOURCE=remote)
VITE_API_URL=https://api.sakuramoonatelier.com
